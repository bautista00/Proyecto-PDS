        <mxCell id="p4-n2" parent="p4-l" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" value="&lt;b&gt;Bajo Acoplamiento + Variaciones Protegidas&lt;/b&gt;&lt;br&gt;El Controller depende de la interfaz, nunca del Impl.&lt;br&gt;Cambiar la implementación no obliga a recompilar la view." vertex="1">
          <mxGeometry height="64" width="700" x="820" y="1400" as="geometry" />
