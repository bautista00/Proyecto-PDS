        <mxCell id="p6-n1" parent="p6-l" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" value="&lt;b&gt;Controlador&lt;/b&gt;&lt;br&gt;El Controller no valida ni calcula: arma el DTO,&lt;br&gt;llama al service y devuelve el resultado a la vista." vertex="1">
          <mxGeometry height="64" width="440" x="80" y="900" as="geometry" />
        </mxCell>
        <mxCell id="p6-e10" edge="1" parent="p6-l" source="p6-ctl" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;strokeColor=#50657B;strokeWidth=1.3;fontFamily=Arial;fontSize=11;fontColor=#38516C;labelBackgroundColor=#FFFFFF;endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#D8B84A;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.4773;entryY=0.0000;entryDx=0;entryDy=0;" target="p6-n1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-n2" parent="p6-l" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" value="&lt;b&gt;Bajo Acoplamiento&lt;/b&gt;&lt;br&gt;TurnoServiceImpl es el único que implementa TurnoService.&lt;br&gt;El resto de las cinco clases son colaboradores internos:&lt;br&gt;nadie fuera de service las conoce." vertex="1">
          <mxGeometry height="79" width="560" x="560" y="900" as="geometry" />
        </mxCell>
        <mxCell id="p6-e11" edge="1" parent="p6-l" source="p6-svi" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;strokeColor=#50657B;strokeWidth=1.3;fontFamily=Arial;fontSize=11;fontColor=#38516C;labelBackgroundColor=#FFFFFF;endArrow=none;dashed=1;dashPattern=3 3;html=1;strokeColor=#D8B84A;exitX=0.5385;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" target="p6-n2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p6-n3" parent="p6-l" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" value="&lt;b&gt;Alta Cohesión · una responsabilidad por clase&lt;/b&gt;&lt;br&gt;registrarTurno() delega: resolver los actores, validar los datos,&lt;br&gt;comprobar la agenda y facturar son cuatro razones distintas&lt;br&gt;de cambio, y por eso viven en cuatro clases distintas." vertex="1">
          <mxGeometry height="79" width="520" x="1660" y="1180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
