        <mxCell id="p4-n1" parent="p4-l" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" value="&lt;b&gt;Controlador&lt;/b&gt;&lt;br&gt;El Controller no tiene lógica: traduce el pedido de la UI a un&lt;br&gt;DTO y delega. Es la única puerta de entrada al modelo." vertex="1">
