        <mxCell id="p5-n1" parent="p5-l" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" value="&lt;b&gt;Alta Cohesión + reutilización del contrato&lt;/b&gt;&lt;br&gt;Las operaciones CRUD viven una sola vez en IRepository&amp;lt;T&amp;gt;.&lt;br&gt;Cada interfaz hija sólo agrega las búsquedas propias de su entidad." vertex="1">
