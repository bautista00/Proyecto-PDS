        </mxCell>
        <mxCell id="p0-x41" value="&lt;b&gt;Nota&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#24364B;strokeColor=none;fillColor=none;" vertex="1" parent="p0-l">
          <mxGeometry x="320" y="738" width="200" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p0-x42" value="Comentario GRASP anclado a un elemento" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#38516C;strokeColor=none;fillColor=none;" vertex="1" parent="p0-l">
          <mxGeometry x="190" y="754" width="460" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p0-cv" value="&lt;b&gt;Convenciones de notación&lt;/b&gt;&lt;br&gt;Nombre en &lt;i&gt;cursiva&lt;/i&gt; = clase o método abstracto.&lt;br&gt;{readOnly} = atributo final. &amp;nbsp; {static} = método de clase.&lt;br&gt;{leaf} = clase final. &amp;nbsp; ~ = visibilidad de paquete (package-private).&lt;br&gt;Bajo el nombre de cada clase figura su paquete de origen." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" vertex="1" parent="p0-l">
          <mxGeometry x="70" y="820" width="790" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p0-x43" value="&lt;b&gt;Los 9 patrones GRASP en este proyecto&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#24364B;strokeColor=none;fillColor=none;" vertex="1" parent="p0-l">
          <mxGeometry x="1060" y="121" width="1000" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p0-g0" value="&lt;b&gt;Experto en Información&lt;/b&gt;&lt;br&gt;Turno.calcularMonto(), Persona.actualizarDatosPersonales(),&lt;br&gt;HistorialTurnos.tieneTurnos(), EstadoTurno.ocupaAgenda().&lt;br&gt;Cada clase responde por los datos que ya posee.&lt;br&gt;→ págs. 2, 3, 14" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" vertex="1" parent="p0-l">
          <mxGeometry x="930" y="160" width="480" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p0-g1" value="&lt;b&gt;Creador&lt;/b&gt;&lt;br&gt;OdontologoFactory.crear() decide qué subtipo instanciar.&lt;br&gt;TurnoServiceImpl crea el Turno porque tiene todos&lt;br&gt;los datos de inicialización.&lt;br&gt;→ págs. 11, 13" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" vertex="1" parent="p0-l">
          <mxGeometry x="1440" y="160" width="480" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p0-g2" value="&lt;b&gt;Controlador&lt;/b&gt;&lt;br&gt;PacienteController, OdontologoController,&lt;br&gt;SecretariaController, TurnoController.&lt;br&gt;Única puerta de entrada de la UI al modelo.&lt;br&gt;→ págs. 4, 9" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" vertex="1" parent="p0-l">
          <mxGeometry x="1950" y="160" width="480" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p0-g3" value="&lt;b&gt;Bajo Acoplamiento&lt;/b&gt;&lt;br&gt;Los Service dependen de I*Repository, no de la&lt;br&gt;implementación. La view sólo conoce controllers y DTO.&lt;br&gt;persistence no conoce a service ni a controller.&lt;br&gt;→ págs. 1, 4, 5" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" vertex="1" parent="p0-l">
          <mxGeometry x="930" y="400" width="480" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p0-g4" value="&lt;b&gt;Alta Cohesión&lt;/b&gt;&lt;br&gt;TurnoServiceImpl delegó en TurnoValidador,&lt;br&gt;DisponibilidadTurnos, TurnoResolutor, TurnoConsultaService.&lt;br&gt;Cada una tiene una sola razón para cambiar.&lt;br&gt;→ págs. 6, 7" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" vertex="1" parent="p0-l">
          <mxGeometry x="1440" y="400" width="480" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p0-g5" value="&lt;b&gt;Polimorfismo&lt;/b&gt;&lt;br&gt;Odontologo.getTarifaBase() / puedeAtender() por subtipo;&lt;br&gt;CoberturaPaciente.calcularMonto() por constante de enum.&lt;br&gt;Sin un solo if/switch sobre el tipo.&lt;br&gt;→ págs. 2, 14" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" vertex="1" parent="p0-l">
          <mxGeometry x="1950" y="400" width="480" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p0-g6" value="&lt;b&gt;Fabricación Pura&lt;/b&gt;&lt;br&gt;Facturador, ValidacionesClinica, OdontologoFactory,&lt;br&gt;FormatoLinea, ArchivoTexto, DependenciasClinica.&lt;br&gt;Clases sin correlato en el dominio, creadas por diseño.&lt;br&gt;→ págs. 7, 10, 11, 12" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" vertex="1" parent="p0-l">
          <mxGeometry x="930" y="640" width="480" height="94" as="geometry" />
        </mxCell>
        <mxCell id="p0-g7" value="&lt;b&gt;Indirección&lt;/b&gt;&lt;br&gt;TurnoResolutor desacopla a TurnoServiceImpl de los cuatro&lt;br&gt;repositorios; PersistenciaServicio media entre config&lt;br&gt;y los archivos de texto.&lt;br&gt;→ págs. 7, 10" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" vertex="1" parent="p0-l">
