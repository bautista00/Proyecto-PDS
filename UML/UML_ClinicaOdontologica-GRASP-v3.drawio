        <mxCell id="p14-n1" value="&lt;b&gt;Fabricación Pura&lt;/b&gt;&lt;br&gt;5-6 · Facturador valida y delega de inmediato. No calcula nada:&lt;br&gt;existe para que el cobro no viva dentro del Service ni dentro de Turno." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" vertex="1" parent="p14-l">
          <mxGeometry x="90" y="1170" width="800" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p14-n2" value="&lt;b&gt;Experto en Información&lt;/b&gt;&lt;br&gt;6-8 · Cada objeto contesta por lo que sabe: el Turno conoce a su&lt;br&gt;paciente, el paciente conoce su cobertura, la cobertura conoce la regla." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" vertex="1" parent="p14-l">
          <mxGeometry x="930" y="1170" width="820" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p14-n3" value="&lt;b&gt;Polimorfismo doble&lt;/b&gt;&lt;br&gt;9 · PARTICULAR devuelve odontologo.getTarifaBase(), que a su vez es&lt;br&gt;polimórfica por especialidad; OBRA_SOCIAL devuelve el copago fijo y ni&lt;br&gt;siquiera llega a preguntar la tarifa. Sumar una cobertura o una&lt;br&gt;especialidad no toca ninguna de estas clases." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontFamily=Arial;fontSize=11;fontColor=#6B5514;strokeColor=#D8B84A;fillColor=#FFF8E1;strokeWidth=1.2;" vertex="1" parent="p14-l">
